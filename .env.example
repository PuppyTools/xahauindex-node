# xahaud WebSocket endpoint (mainnet default)
XAHAUD_URL=wss://xahau.network

# SQLite database path (created automatically)
DB_PATH=./data/xahauindex.db

# API listen address
API_PORT=3000
API_HOST=0.0.0.0

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Optional: historical transaction backfill start (v1.1, unused in v1)
# FULL_HISTORY_START=
