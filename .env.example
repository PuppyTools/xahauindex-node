# xahaud WebSocket endpoint (mainnet default)
XAHAUD_URL=wss://xahau.network

# SQLite database path (created automatically)
DB_PATH=./data/xahauindex.db

# API listen address
API_PORT=3000
API_HOST=0.0.0.0
# Public origin for /docs cookbook curls, Open links, and /v1/openapi.yaml.
# Unset = http://localhost:3000. Does not change the listen address.
# Project site: https://xahauindex.dev
# API_BASE_URL=https://xahauindex.dev

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Historical transaction backfill (unset = skip). Snapshot stays the current-state source.
# Walk is snapshot → this ledger. "genesis" or "start" means keep going until ledger 1.
# Wins over LOOKBACK.
# BACKFILL_FROM_LEDGER=genesis
# Alias for BACKFILL_FROM_LEDGER
# FULL_HISTORY_START=
# If FROM is unset, walk LOOKBACK ledgers back from the snapshot.
# BACKFILL_LOOKBACK=10000
# Dedicated full-history node for backfill only (live/snapshot still use XAHAUD_URL).
# WebSocket (ws/wss) or JSON-RPC (http/https). Unset = reuse XAHAUD_URL.
# BACKFILL_XAHAUD_URL=wss://your-full-history-node
# Or put XAHAUD_URL / BACKFILL_XAHAUD_URL in a second env file (see .env.backfill.example).
# BACKFILL_ENV=.env.backfill
# Delay between historical ledger fetches (ms). Unset = 2000 when sharing XAHAUD_URL,
# 0 when BACKFILL_XAHAUD_URL is a different node. 0 disables pacing.
# BACKFILL_MIN_INTERVAL_MS=2000

# Optional operator HTTP rate limit. Unset / 0 = off (no API keys).
# API_RATE_LIMIT_MAX=120
# API_RATE_LIMIT_WINDOW_MS=60000
# Trust X-Forwarded-For only when Caddy/nginx is in front. Leave false on a bare :3000.
# API_TRUST_PROXY=false
# Comma-separated IPs / CIDRs that skip the limiter (health checks, your monitor).
# API_RATE_LIMIT_ALLOW=127.0.0.1
# Concurrent /v1/subscribe sockets per IP. Unset = 8 when MAX is set, unlimited when MAX is off.
# 0 disables the cap even if MAX is set.
# API_WS_MAX_PER_IP=8
