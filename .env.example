# xahaud WebSocket endpoint (mainnet default)
XAHAUD_URL=wss://xahau.network

# SQLite database path (created automatically)
DB_PATH=./data/xahauindex.db

# API listen address
API_PORT=3000
API_HOST=0.0.0.0

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Historical transaction backfill (unset = skip). Snapshot stays the current-state source.
# Absolute start ledger. "genesis" or "start" means ledger 1. Wins over LOOKBACK.
# BACKFILL_FROM_LEDGER=genesis
# Alias for BACKFILL_FROM_LEDGER
# FULL_HISTORY_START=
# If FROM is unset, start at snapshot_ledger - LOOKBACK + 1
# BACKFILL_LOOKBACK=10000
# Dedicated full-history node for backfill only (live/snapshot still use XAHAUD_URL).
# WebSocket (ws/wss) or JSON-RPC (http/https). Unset = reuse XAHAUD_URL.
# BACKFILL_XAHAUD_URL=wss://your-full-history-node
# Or put XAHAUD_URL / BACKFILL_XAHAUD_URL in a second env file (see .env.backfill.example).
# BACKFILL_ENV=.env.backfill
