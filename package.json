{
  "name": "xahauindex-node",
  "version": "0.1.0",
  "description": "Self-hostable metadata indexer for the Xahau network",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-migrations.js",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/type-provider-typebox": "^4.1.0",
    "@fastify/websocket": "^10.0.1",
    "@sinclair/typebox": "^0.32.37",
    "@transia/xrpl": "^4.4.6-alpha.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "fastify": "^4.29.1",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
